root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
# Matches google-java-format (AOSP style), enforced by the Spotless plugin on
# every `mvn verify` — keep this in sync with pom.xml's spotless-maven-plugin
# config so editors agree with what the auto-formatter actually writes.
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.xml]
indent_style = tab
indent_size = 4

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{proto}]
indent_style = space
indent_size = 2

[*.sql]
indent_style = space
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf
